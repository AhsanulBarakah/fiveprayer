// tsconfig.json this will help you to configure the typescript compiler options specailly for wordpress
{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ES2020",
      "moduleResolution": "bundler",
      "strict": true,
      "jsx": "react-jsx",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      // Global type packages (tests read the build with node:fs).
      "types": ["node"]
    },
    // Every TypeScript/TSX file in the project: the admin app and its unit
    // tests. Blocks are plain JS and the browser/PHP suites are not TypeScript.
    "include": ["src", "tests"]
  }