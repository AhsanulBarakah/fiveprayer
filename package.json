{
  "name": "fiveprayer",
  "version": "3.0.0",
  "description": "Five Prayer Plugin is For Muslim WordPress Website",
  "author": "jamaaldev",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "prayer",
    "muslim",
    "fiveprayer"
  ],
  "sideEffects": true,
  "homepage": "https://github.com/AhsanulBarakah/fiveprayer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhsanulBarakah/fiveprayer.git"
  },
  "bugs": {
    "url": "https://github.com/AhsanulBarakah/fiveprayer/issues"
  },
  "files": [
    "build-admin",
    "build-blocks",
    "php",
    "vendor",
    "languages",
    "LICENSE.txt",
    "README.md",
    "changelog.txt",
    "/Fiveprayer.php",
    "/uninstall.php",
    "index.php"
  ],
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"wp-scripts start --webpack-src-dir=src --webpack-copy-svg --webpack-copy-php --output-path=./build-admin/\" \"wp-scripts start --webpack-src-dir=blocks --webpack-copy-php --output-path=./build-blocks/\"",
    "build": "npm run lint:css && npm run typecheck && cross-env NODE_ENV=production wp-scripts build --webpack-src-dir=blocks --webpack-copy-php --output-path=./build-blocks/ && cross-env NODE_ENV=production wp-scripts build --webpack-src-dir=src --output-path=./build-admin/",
    "plugin:zip": "node tools/pack-plugin.mjs",
    "plugin:check:prod": "wp plugin check fiveprayer --exclude-directories=src,blocks,docs,utils,.kilo,.freebuff --exclude-files=.babelrc,postcss.config.js,tailwind.config.js,tsconfig.json,webpack.config.js,removeEmptyTypesPlugin.js,package.json,pnpm-lock.yaml,pnpm-workspace.yaml,composer.json,composer.lock,.gitattributes,.gitignore,.pcpignore,.distignore --exclude-checks=enqueued_scripts_size,enqueued_styles_size,enqueued_styles_scope,enqueued_scripts_scope,non_blocking_scripts",
    "packages-update": "wp-scripts packages-update",
    "test": "npm run test:unit && npm run test:js && npm run test:php",
    "test:unit": "vitest run",
    "test:js": "node tests/js/test-tv-display-fit.mjs",
    "test:php": "php tests/php/test-security-hardening.php && php tests/php/test-css-scoping.php && php tests/php/test-timetable-month.php && php tests/php/test-asr-second.php && php tests/php/test-asr2-translation.php && php tests/php/test-dynamic-text.php",
    "test:tv": "node tests/js/test-tv-display-fit.mjs",
    "docs:screenshots": "node tools/docs-screenshots.mjs",
    "readme:screenshots": "node tools/setup-screenshots.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "lint:css": "node tools/check-css-scope.mjs",
    "lint:php-security": "node tools/security-scan.mjs",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-react-constant-elements": "^8.0.5",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wordpress/components": "^43.0.0",
    "@wordpress/data": "^11.0.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^7.0.0",
    "@wordpress/env": "^12.0.0",
    "@wordpress/i18n": "^7.0.0",
    "@wordpress/scripts": "^37.0.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "cssnano": "^9.9.0",
    "postcss-prefix-selector": "^2.2.1",
    "styled-components": "^6.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.7",
    "@wordpress/api-fetch": "^8.0.0",
    "@wordpress/url": "^5.0.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router": "^8.5.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "browserslist": [
    ">0.25%",
    "not dead",
    "not op_mini all"
  ],
  "packageManager": "pnpm@12.15.0"
}
