#: build-admin/300.js:1
msgid "Understanding Calculation Parameters"
msgstr ""

#: build-admin/300.js:1
msgid "Each prayer calculation method has parameters that define how prayer times are computed. Here's what each parameter means:"
msgstr ""

#: build-admin/300.js:1
msgid "Fajr Angle (degrees)"
msgstr ""

#: build-admin/300.js:1
msgid "The sun's angle below the horizon that determines when Fajr begins. This is based on the twilight angle."
msgstr ""

#: build-admin/300.js:1
msgid "Common Values:"
msgstr ""

#: build-admin/300.js:1
msgid " 18°, 15°, 12°, 11°, or 19.5°"
msgstr ""

#: build-admin/300.js:1
msgid " Lower angles result in later Fajr times. Higher angles result in earlier Fajr times."
msgstr ""

#: build-admin/300.js:1
msgid "Isha Angle (degrees)"
msgstr ""

#: build-admin/300.js:1
msgid "The sun's angle below the horizon that determines when Isha begins. Alternatively, you can specify minutes after Maghrib."
msgstr ""

#: build-admin/300.js:1
msgid " 17°, 18°, 15°, 12°, or "
msgstr ""

#: build-admin/300.js:1
msgid " When entering minutes, use the format "
msgstr ""

